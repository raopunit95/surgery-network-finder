{
  "name": "surgery-network-finder",
  "version": "2.0.0",
  "description": "Find cashless hospitals near a pincode by surgery and insurer, then see the doctors at that hospital. Static site, no backend, no dependencies.",
  "type": "module",
  "private": true,
  "scripts": {
    "refresh": "node tools/refresh.mjs && node tools/check.mjs",
    "refresh:dry": "node tools/refresh.mjs --dry-run",
    "refresh:sheet": "node tools/refresh.mjs --source=sheet && node tools/check.mjs",
    "sample": "node tools/refresh.mjs --source=sample && node tools/check.mjs",
    "check": "node tools/check.mjs",
    "test": "node tools/test-taxonomy.mjs && node tools/test-e2e.mjs",
    "test:map": "node tools/test-taxonomy.mjs",
    "pincodes": "node tools/build-pincodes.mjs",
    "serve": "python3 -m http.server 8080"
  },
  "engines": {
    "node": ">=18"
  }
}
